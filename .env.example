# Any OpenAI-compatible endpoint (Doubao / Ark, DeepSeek, OpenAI, local proxy, ...)
VITE_OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VITE_OPENAI_API_KEY=replace-with-your-key
VITE_OPENAI_MODEL=doubao-seed-2-1-lite-260915
# 图生图/改图模型（Seedream 或 SeedEdit 的模型 ID / 接入点 ID）
VITE_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
# 画布 Logo（可选，图片 URL 或 data URL；也可以在画布设置里直接上传）
VITE_BRAND_LOGO=
# 电商主图固定尺寸（1:1），默认 1440x1440
VITE_MAIN_IMAGE_SIZE=1440x1440
# Seedance 视频模型 / 接入点（图生视频、视频编辑）
VITE_VIDEO_MODEL=
