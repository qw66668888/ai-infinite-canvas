{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "native/app",
    "rootDir": "src",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src"]
}
